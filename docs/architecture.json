        "position": {
          "type": "RoPE",
          "theta": 10000.0,
          "compute_dtype": "float32",
          "output_dtype": "input activation dtype",
          "applied_to": ["q", "k"]
        },
        "kernel": "torch.nn.functional.scaled_dot_product_attention",
        "causal_rule": "is_causal for multi-token input; false for a cached single-token query",
        "gqa": {
          "configurable": true,
          "accepted_profiles_use_full_mha": true,
          "repeat_after_rope": true,
          "cache_before_repeat": true
        },
        "output_projection": {
          "bias": false,
          "input": "n_heads * head_dim",
          "output": "dim",
          "residual_output_scaled_initialization": true
        },
        "decision_ids": ["D007", "D010", "D019"]
      },
      "feed_forward": {
        "type": "SwiGLU",
        "formula": "down(silu(gate(x)) * up(x))",
        "gate_projection": {"bias": false, "input": "dim", "output": "ffn_dim"},
        "up_projection": {"bias": false, "input": "dim", "output": "ffn_dim"},
        "gate_and_up_are_currently_fused": false,
        "projection_fusion_decision": "D019",
        "down_projection": {
          "bias": false,
          "input": "ffn_dim",
          "output": "dim",
          "residual_output_scaled_initialization": true
        },
        "decision_ids": ["D008", "D019"]
      },
      "residual_equations": [
        "x = x + attention(attention_rmsnorm(x))",
        "x = x + swiglu(ffn_rmsnorm(x))"
      ],
      "decision_ids": ["D005", "D006"]
    },
    "final_normalization": {
      "type": "RMSNorm",
      "dimension": "dim",
      "epsilon": 0.000001,
      "decision_ids": ["D006"]
    },
    "lm_head": {
      "type": "torch.nn.Linear",
      "shape": [16384, "dim"],
      "bias": false,
      "tied_to_embedding": false,
      "compute_bearing": true,
      "decision_ids": ["D009", "D016"]
    },
    "initialization": {
      "default": {"distribution": "normal", "mean": 0.0, "std": 0.02},
      "residual_output_projections": {
        "names": ["o_proj.weight", "down_proj.weight"],
        "std_formula": "0.02 / sqrt(2 * n_layers)"
      },
      "decision_ids": ["D006"]
    },
