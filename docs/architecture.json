        "output_dtype": "input activation dtype",
        "decision_ids": ["D006"]
      },
      "attention": {
        "q_projection": {"bias": false, "input": "dim", "output": "n_heads * head_dim"},
        "k_projection": {"bias": false, "input": "dim", "output": "n_kv_heads * head_dim"},
        "v_projection": {"bias": false, "input": "dim", "output": "n_kv_heads * head_dim"},
        "projections_are_currently_fused": false,
        "projection_fusion_decision": "D019",
        "qk_norm": {
          "enabled": true,
          "type": "RMSNorm",
          "normalized_dimension": "head_dim",
          "placement": "after projection, before RoPE"
