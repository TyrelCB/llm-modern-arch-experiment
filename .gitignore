__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
# Checkpoints are large; metrics JSON and logs are kept.
runs/**/*.pt
runs/**/*.tmp
runs/**/evaluation*.jsonl
# Per-example benchmark records; the aggregated comparison JSON is kept.
runs/eval*-*.jsonl
# Capability-curve sweeps: the per-checkpoint summary JSON is the result, the
# per-example records behind it are ~2MB each and regenerate from checkpoints.
runs/curve*/*.jsonl
data/
